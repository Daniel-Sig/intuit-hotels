# Copy to .env. Leave all LLM settings empty to run retrieval-only (no generated answer).

# Option A: Gemini free tier (key from https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite   # default; free-tier model names change over time

# Option B: local Ollama (ollama pull qwen2.5:3b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT=120

# Option C: OpenAI (the brief's model)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Optional switches
# RERANK=0          # skip the cross-encoder
# VERIFY_CLAIMS=0   # skip the second LLM pass that removes unsupported sentences
# LLM_PLANNER=0     # use the rule-based parser instead of the LLM planner
